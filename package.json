{
  "name": "borrom-ds-test",
  "private": false,
  "version": "0.0.70",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/borrom-ds-test.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/borrom-ds-test.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "yarn@1.22.22",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "server:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev-server.ps1",
    "server:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-server.ps1",
    "dev:vite": "vite",
    "build": "yarn build:lib && yarn build:types",
    "build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:lib": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "figma:status": "node scripts/figma-connection-status.js",
    "figma:status:write": "node scripts/figma-connection-status.js --write",
    "prepare": "husky",
    "bump": "node scripts/bump-version.js",
    "precommit": "lint-staged",
    "commit": "node scripts/commit.js"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "react-day-picker": "^9.6.0",
    "react-intersection-observer": "^10.0.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/js": "^9.15.0",
    "@storybook/addon-a11y": "^10.2.1",
    "@storybook/addon-links": "^10.2.1",
    "@storybook/react": "^10.2.1",
    "@storybook/react-vite": "^10.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^10.2.1",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "immer": "^10.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "react": "^19.0.0-rc.1",
    "react-dom": "^19.0.0-rc.1",
    "storybook": "^10.2.1",
    "tailwind-animate": "^0.2.10",
    "tailwindcss": "^4.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.0"
  }
}
